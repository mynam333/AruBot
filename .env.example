# Server configuration
SERVER_PORT=3001
APP_REDIRECT_AFTER_LOGIN=http://localhost:3000/?auth=success
OAUTH_STATE_SECRET=replace_with_stable_random_32_bytes
# Required in production. Use a stable random secret and do not rotate without a token migration plan.
ARUBOT_SECRET_ENCRYPTION_KEY=replace_with_stable_random_32_bytes
ARUBOT_REQUIRE_TOKEN_ENCRYPTION_KEY=true
# Production origins. Use the exact deployed URLs without trailing slash.
# FRONTEND_ORIGIN=https://arubot.example.com
# BACKEND_ORIGIN=https://api.example.com
# Leave COOKIE_DOMAIN empty for host-only cookies. Set only when you intentionally
# share cookies across subdomains, e.g. COOKIE_DOMAIN=.example.com
# COOKIE_DOMAIN=
# PM2/runtime tuning
# ARUBOT_PROCESS_ROLE=api-runtime
# ARUBOT_PM2_MAX_MEMORY_RESTART=900M
# ARUBOT_NODE_MAX_OLD_SPACE_SIZE=768
# Runtime logs are always written under the project directory: logs/api.out.log and logs/api.err.log.
# ARUBOT_ENABLE_LEGACY_SQLITE=false

# Frontend configuration (Next.js)
# Base URL for backend API when frontend is hosted separately (e.g., Netlify/Vercel)
# Examples:
# NEXT_PUBLIC_API_BASE=http://localhost:3001
# NEXT_PUBLIC_API_BASE=https://your-backend.example.com
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_APP_URL=
# Optional explicit local program build URLs. If omitted, the local program uses
# BACKEND_ORIGIN/NEXT_PUBLIC_API_BASE and FRONTEND_ORIGIN/NEXT_PUBLIC_APP_URL.
# ARUBOT_LOCAL_BACKEND_URL=https://api.example.com
# ARUBOT_LOCAL_DASHBOARD_URL=https://arubot.example.com
# Server-side API base for Next.js rewrites/server components. In production, set this
# to the same URL as NEXT_PUBLIC_API_BASE unless you intentionally use an internal URL.
# API_BASE=https://your-backend.example.com
# SERVER_API_BASE=https://your-backend.example.com

# CHZZK OAuth credentials (from CHZZK Developer Center app)
CHZZK_CLIENT_ID=your_chzzk_client_id
CHZZK_CLIENT_SECRET=your_chzzk_client_secret
# Must exactly match one of the Login Redirect URLs registered in Chzzk app settings
CHZZK_REDIRECT_URI=http://localhost:3001/api/auth/chzzk/callback
CHZZK_UNOFFICIAL_API_BASE=https://api.chzzk.naver.com
# Registered CHZZK broadcasts are checked on this cadence so chat sessions start without an open dashboard.
REGISTERED_RUNTIME_MONITOR_INTERVAL_MS=10000
REGISTERED_RUNTIME_MONITOR_CONCURRENCY=4
PROVIDER_RUNTIME_LEASE_TTL_MS=45000
PROVIDER_RUNTIME_LEASE_RENEW_MS=15000
# Keep true only while older desktop/Warudo clients still connect with ?token=.
# New clients must exchange their scoped API key at POST /api/apikey/ws-ticket and connect with ?ticket=.
ARUBOT_ALLOW_LEGACY_WS_QUERY_API_KEY=true

# CIME OAuth credentials (from CIME Developers app)
CIME_CLIENT_ID=your_cime_client_id
CIME_CLIENT_SECRET=your_cime_client_secret
CIME_REDIRECT_URI=http://localhost:3001/api/auth/cime/callback
CIME_OPENAPI_BASE=https://ci.me/api/openapi
CIME_AUTH_SCOPE=READ:USER READ:CHANNEL READ:LIVE_CHAT WRITE:LIVE_CHAT READ:DONATION READ:SUBSCRIPTION READ:LIVE_STREAM_SETTINGS WRITE:LIVE_STREAM_SETTINGS
# CIME manager-role cache TTL used by privileged live-change command variables (10s-5m)
CIME_LIVE_MANAGER_CACHE_TTL_MS=60000
CIME_APP_API_BASE=https://ci.me/api/app
# Optional. Use when CIME public profile endpoint changes. Placeholders: {channelId}, {handle}
CIME_UNOFFICIAL_PROFILE_URL_TEMPLATE=
PLATFORM_PROFILE_TIMEOUT_MS=2500

# YouTube OAuth credentials (Google Cloud OAuth client + YouTube Data API v3)
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/auth/youtube/callback
# Viewer linking and YouTube-only streamer start only need read-only channel identity.
YOUTUBE_CHANNEL_READ_AUTH_SCOPE=https://www.googleapis.com/auth/youtube.readonly
YOUTUBE_VIEWER_AUTH_SCOPE=https://www.googleapis.com/auth/youtube.readonly
YOUTUBE_STREAMER_AUTH_SCOPE=https://www.googleapis.com/auth/youtube.readonly
# Central bot chat send/receive needs a writable YouTube scope.
YOUTUBE_BOT_AUTH_SCOPE=https://www.googleapis.com/auth/youtube.force-ssl
# Legacy fallback for older deployments. Prefer YOUTUBE_BOT_AUTH_SCOPE.
# YOUTUBE_AUTH_SCOPE=https://www.googleapis.com/auth/youtube.force-ssl
YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3
# Server-streamed live chat endpoint. Do not switch to polling for normal operation.
YOUTUBE_STREAM_PATH=/liveChat/messages/stream
# Central bot profile id is not a channel id. The actual bot channel is selected in the admin UI.
YOUTUBE_BOT_PROFILE_ID=default
# Public backend callback used by YouTube WebSub push notifications.
YOUTUBE_WEBSUB_CALLBACK_PATH=/api/youtube/websub/callback
YOUTUBE_WEBSUB_HUB_URL=https://pubsubhubbub.appspot.com/subscribe
YOUTUBE_WEBSUB_VERIFY_TOKEN=

# Database provider. Production uses direct Postgres, e.g. Oracle Cloud PostgreSQL.
# Use "supabase" only for legacy/local Supabase deployments.
ARUBOT_DB_PROVIDER=postgres

# Supabase provider
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_POOL_MAX=10
SUPABASE_DB_CONNECT_TIMEOUT_MS=5000
SUPABASE_DB_STATEMENT_TIMEOUT_MS=15000
SUPABASE_DB_IDLE_TIMEOUT_MS=30000

# Postgres provider. Required when ARUBOT_DB_PROVIDER=postgres.
# In postgres provider, the backend must not depend on official Supabase URLs or keys.
POSTGRES_URL=
POSTGRES_RUNTIME_URL=
POSTGRES_MIGRATION_URL=
POSTGRES_POOL_MAX=5
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=10000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_SSL=verify-full
# Set one of these when the database certificate is signed by a private CA.
POSTGRES_SSL_CA_FILE=
POSTGRES_SSL_CA=
# Only for a one-off shell that needs both SUPABASE_DB_URL and POSTGRES_URL, e.g. count comparison.
# Keep false/empty in normal postgres provider operation.
ARUBOT_ALLOW_SUPABASE_ENV_WITH_POSTGRES=false
# Keep false/empty in normal postgres provider operation. This only exists for explicit diagnostics.
ARUBOT_ALLOW_SUPABASE_POSTGRES_URL=false
# Disable periodic database analysis scheduler in lightweight operation unless explicitly needed.
ARUBOT_SUPABASE_PERF_MONITORING=false

# Privacy retention cleanup. Set a value to 0 to disable cleanup for that data class.
ARUBOT_PRIVACY_RETENTION_CLEANUP=true
ARUBOT_PRIVACY_RETENTION_CLEANUP_INTERVAL_MS=86400000
YOUTUBE_AUTH_VALIDATION_INTERVAL_MS=86400000
YOUTUBE_AUTH_VALIDATION_MAX_AGE_MS=2505600000
YOUTUBE_AUTH_INACTIVITY_MAX_AGE_MS=15552000000
ARUBOT_BOT_EVENT_LOG_RETENTION_DAYS=365
ARUBOT_DRAWING_DONATION_RETENTION_DAYS=365
ARUBOT_PREDICTION_RETENTION_DAYS=365
ARUBOT_VIDEO_DONATION_RETENTION_DAYS=365
ARUBOT_AUTOMATION_JOB_RETENTION_DAYS=90
ARUBOT_ACTION_RUN_RETENTION_DAYS=180

REDIS_URL=
# Optional API key for video donation/search metadata and resolving YouTube handles.
# Live chat send/receive uses the central bot OAuth profile selected in the admin UI.
YOUTUBE_API_KEY=
