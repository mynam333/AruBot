# Server configuration
SERVER_PORT=3001
APP_REDIRECT_AFTER_LOGIN=http://localhost:3000/?auth=success
# Production origins. Use the exact deployed URLs without trailing slash.
# FRONTEND_ORIGIN=https://arubot.example.com
# BACKEND_ORIGIN=https://api.example.com
# PM2/runtime tuning
# ARUBOT_PROCESS_ROLE=api-runtime
# ARUBOT_PM2_MAX_MEMORY_RESTART=900M
# ARUBOT_NODE_MAX_OLD_SPACE_SIZE=768
# ARUBOT_LOG_DIR=/opt/arubot/shared/logs

# Frontend configuration (Next.js)
# Base URL for backend API when frontend is hosted separately (e.g., Netlify/Vercel)
# Examples:
# NEXT_PUBLIC_API_BASE=http://localhost:3001
# NEXT_PUBLIC_API_BASE=https://your-backend.example.com
NEXT_PUBLIC_API_BASE=
# Server-side API base for Next.js rewrites/server components. In production, set this
# to the same URL as NEXT_PUBLIC_API_BASE unless you intentionally use an internal URL.
# API_BASE=https://your-backend.example.com
# SERVER_API_BASE=https://your-backend.example.com

# CHZZK OAuth credentials (from CHZZK Developer Center app)
CHZZK_CLIENT_ID=your_chzzk_client_id
CHZZK_CLIENT_SECRET=your_chzzk_client_secret
# Must exactly match one of the Login Redirect URLs registered in Chzzk app settings
CHZZK_REDIRECT_URI=http://localhost:3001/api/auth/chzzk/callback
CHZZK_UNOFFICIAL_API_BASE=https://api.chzzk.naver.com

# CIME OAuth credentials (from CIME Developers app)
CIME_CLIENT_ID=your_cime_client_id
CIME_CLIENT_SECRET=your_cime_client_secret
CIME_REDIRECT_URI=http://localhost:3001/api/auth/cime/callback
CIME_OPENAPI_BASE=https://ci.me/api/openapi
CIME_APP_API_BASE=https://ci.me/api/app
# Optional. Use when CIME public profile endpoint changes. Placeholders: {channelId}, {handle}
CIME_UNOFFICIAL_PROFILE_URL_TEMPLATE=
PLATFORM_PROFILE_TIMEOUT_MS=2500

SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

REDIS_URL=
YOUTUBE_API_KEY=
