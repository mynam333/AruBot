{
  "name": "arubot",
  "private": true,
  "version": "0.1.0",
  "description": "AruBot streaming chatbot and automation service",
  "author": "AruBot",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "predev": "node scripts/copy-sfx.js",
    "dev": "next dev",
    "server": "node server/index.js",
    "dev:server": "npm run server",
    "local:app": "electron local-program/main.cjs",
    "local:debug": "electron --inspect=9229 local-program/main.cjs",
    "local:icon": "node scripts/create-local-program-icon.js",
    "local:dist": "electron-builder --config electron-builder.local.yml",
    "local:manifest": "node scripts/write-local-program-manifest.js",
    "local:release": "node scripts/build-local-program.js",
    "local:release:external": "node scripts/build-local-program.js --external",
    "extension:build": "node scripts/build-browser-extension.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:migration-status": "node scripts/db-migration-status.js",
    "db:dump-public": "node scripts/db-dump-public.js",
    "db:restore-public": "node scripts/db-restore-public.js",
    "db:repair-sequences": "node scripts/db-repair-sequences.js",
    "db:counts": "node scripts/db-row-counts.js",
    "db:compare-counts": "node scripts/db-compare-counts.js",
    "db:compare-checksums": "node scripts/db-compare-checksums.js",
    "db:diff-table": "node scripts/db-diff-table.js",
    "db:sync-volatile-tables": "node scripts/db-sync-volatile-tables.js",
    "db:cutover-preflight": "node scripts/db-cutover-preflight.js",
    "db:cutover-verify": "node scripts/db-cutover-verify.js",
    "db:cutover-rehearsal": "node scripts/db-cutover-rehearsal.js",
    "db:switch-to-postgres": "node scripts/db-switch-to-postgres.js",
    "db:provider-smoke": "node scripts/db-provider-smoke.js",
    "api:smoke": "node scripts/api-smoke.js",
    "audit:production": "node scripts/audit-production-dependencies.cjs",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --env production --update-env",
    "pm2:stop": "pm2 stop arubot-api",
    "pm2:logs": "pm2 logs arubot-api",
    "prebuild": "node scripts/copy-sfx.js",
    "build": "next build",
    "lint": "eslint .",
    "preview": "next start",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.1",
    "axios": "^1.7.7",
    "better-sqlite3": "^9.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.414.0",
    "motion": "^12.42.1",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "pg": "^8.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "2.0.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.18.3",
    "youtube-chat": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "autoprefixer": "^10.4.18",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.9.0",
    "jest": "^30.2.0",
    "playwright": "^1.61.1",
    "postcss": "8.5.16",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
