{
  "name": "arubot",
  "private": true,
  "version": "0.1.0",
  "description": "AruBot streaming chatbot and automation service",
  "author": "AruBot",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "predev": "node scripts/copy-sfx.js",
    "dev": "next dev",
    "server": "node server/index.js",
    "dev:server": "npm run server",
    "build:local-fx": "node scripts/build-local-fx.js",
    "prelocal:app": "npm run build:local-fx",
    "local:app": "electron local-program/main.cjs",
    "prelocal:debug": "npm run build:local-fx",
    "local:debug": "electron --inspect=9229 local-program/main.cjs",
    "local:icon": "node scripts/create-local-program-icon.js",
    "local:dist": "electron-builder --config electron-builder.local.yml",
    "local:manifest": "node scripts/write-local-program-manifest.js",
    "local:release": "node scripts/build-local-program.js",
    "local:release:external": "node scripts/build-local-program.js --external",
    "extension:build": "node scripts/build-browser-extension.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:migration-status": "node scripts/db-migration-status.js",
    "db:dump-public": "node scripts/db-dump-public.js",
    "db:restore-public": "node scripts/db-restore-public.js",
    "db:repair-sequences": "node scripts/db-repair-sequences.js",
    "db:counts": "node scripts/db-row-counts.js",
    "db:compare-counts": "node scripts/db-compare-counts.js",
    "db:compare-checksums": "node scripts/db-compare-checksums.js",
    "db:diff-table": "node scripts/db-diff-table.js",
    "db:sync-volatile-tables": "node scripts/db-sync-volatile-tables.js",
    "db:cutover-preflight": "node scripts/db-cutover-preflight.js",
    "db:cutover-verify": "node scripts/db-cutover-verify.js",
    "db:cutover-rehearsal": "node scripts/db-cutover-rehearsal.js",
    "db:switch-to-postgres": "node scripts/db-switch-to-postgres.js",
    "db:provider-smoke": "node scripts/db-provider-smoke.js",
    "api:smoke": "node scripts/api-smoke.js",
    "audit:production": "node scripts/audit-production-dependencies.cjs",
    "verify:backend": "node scripts/verify-backend-safety.cjs",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "accounts:cleanup": "node scripts/cleanup-unlinked-accounts.js",
    "test:accounts": "node --test tests/unlinked-account-cleanup.test.mjs tests/platform-token-guard.test.mjs tests/chzzk-token-persistence.test.mjs tests/account-local-files.test.mjs",
    "test:donations": "node --test tests/donation-response.test.mjs tests/donation-test-and-regex.test.mjs",
    "test:chat-runtime": "node --test tests/chat-ingress*.test.mjs tests/chat-runtime*.test.mjs tests/runtime-handoff*.test.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --env production --update-env",
    "pm2:stop": "pm2 stop arubot-api",
    "pm2:logs": "pm2 logs arubot-api",
    "prebuild": "node scripts/copy-sfx.js",
    "build": "next build",
    "lint": "eslint .",
    "preview": "next start",
    "test": "jest",
    "test:drawing": "node --test tests/drawing-v2.test.mjs tests/drawing-selection.test.mjs tests/drawing-local-storage.test.mjs tests/drawing-archive.test.mjs tests/drawing-retention.test.mjs",
    "test:avatars": "node --test tests/local-avatars.test.cjs tests/local-avatars-engine-v3.test.cjs tests/local-avatars-engine-review.test.cjs tests/local-avatars-service-v3.test.cjs tests/local-avatars-overlay-v3.test.cjs tests/local-avatar-relay.test.mjs",
    "test:avatars:ui": "node --test tests/local-avatars-editor-v3.test.cjs",
    "test:pngtuber": "node --test tests/local-pngtuber-core.test.cjs tests/local-pngtuber-service.test.cjs tests/local-pngtuber-integration.test.cjs",
    "test:pngtuber:ui": "node --test tests/local-pngtuber-editor.test.cjs",
    "test:wheel": "node --test tests/participation-wheel-core.test.mjs tests/participation-wheel-store.test.mjs tests/participation-wheel-runtime.test.mjs src/features/wheel/wheel-motion.test.mjs",
    "test:emotes": "node --test tests/emote-connection.test.mjs tests/emote-engine.test.mjs tests/emote-overlay-extractor.test.mjs tests/emote-overlay-runtime.test.mjs tests/emote-overlay-store.test.mjs tests/emote-overlay-routes.test.mjs",
    "test:marble": "node --test tests/marble-engine.test.mjs tests/marble-store.test.mjs tests/marble-routes.test.mjs tests/marble-runtime.test.mjs tests/marble-postgres.test.mjs tests/marble-client.test.mjs src/features/marble/marble-presentation.test.mjs src/features/marble/marble-dice-motion.test.mjs",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^9.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "hls.js": "^1.6.16",
    "ipaddr.js": "1.9.1",
    "lucide-react": "^0.414.0",
    "matter-js": "0.20.0",
    "motion": "^12.42.1",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "perfect-freehand": "1.2.3",
    "perspective-transform": "1.1.3",
    "pg": "^8.11.5",
    "proxy-addr": "2.0.8",
    "re2-wasm": "1.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "safe-regex2": "^5.1.1",
    "sharp": "0.35.5",
    "socket.io-client": "2.0.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "0.186.1",
    "ws": "8.21.1",
    "youtube-chat": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "autoprefixer": "^10.4.18",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.9.0",
    "jest": "^30.2.0",
    "playwright": "^1.61.1",
    "postcss": "8.5.31",
    "semver": "7.8.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.1"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "source-map-js": "1.2.2"
  }
}
